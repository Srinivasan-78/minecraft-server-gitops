# Server definition. Edited in git, synced to the VM by the deploy workflow.
# Every value here is also overridable per-run via workflow inputs.

# Server software: vanilla | paper
MC_TYPE=paper

# Minecraft version, or "latest" for the newest release.
MC_VERSION=1.21.4

# JVM heap. Leave a couple of GB of the VM's RAM for the OS.
MC_MEMORY=4G

# Extra JVM flags (Aikar's flags, trimmed).
MC_JAVA_ARGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -XX:+PerfDisableSharedMem"

# Java major version to install and run with.
MC_JAVA_VERSION=21
